  '1.4.1':
    type: automatic
    command: |
      user_cfg="/boot/grub2/user.cfg"

      if [ ! -s "$user_cfg" ]; then
        echo "$user_cfg is missing or empty"
        exit 1
      fi

      if ! grep -Eq '^GRUB2_PASSWORD=grub\.pbkdf2\.sha512\.' "$user_cfg"; then
        echo "Valid GRUB2 PBKDF2 password hash is missing from $user_cfg"
        exit 1
      fi

      echo "Valid GRUB2 PBKDF2 password is configured in $user_cfg"
      exit 0
    remediation_safe: true
    validation_source: "Tenable CIS Red Hat Enterprise Linux 9 v2.0.0 L1 Server"

  '1.4.2':
    type: automatic
    remediation_safe: true
    validation_source: "Tenable CIS_Red_Hat_Enterprise_Linux_9_v2.0.0_L1_Server.audit rev 1.15"

    command: |
      failed=0
      checked=0

      check_grub_file() {
        file="$1"
        forbidden_permissions="$2"
        required_mode="$3"

        [ -e "$file" ] || return 0

        checked=$((checked + 1))

        uid="$(stat -Lc '%u' "$file")"
        gid="$(stat -Lc '%g' "$file")"
        mode="$(stat -Lc '%a' "$file")"

        echo "File: $file mode=$mode uid=$uid gid=$gid"

        if [ "$uid" -ne 0 ]; then
          echo "NON_COMPLIANT: $file is not owned by root"
          failed=1
        fi

        if [ "$gid" -ne 0 ]; then
          echo "NON_COMPLIANT: $file is not group-owned by root"
          failed=1
        fi

        if find -L "$file" -prune \
          -perm "/$forbidden_permissions" \
          -print -quit | grep -q .
        then
          echo "NON_COMPLIANT: $file is not mode $required_mode or more restrictive"
          failed=1
        fi
      }

      # UEFI GRUB files:
      # Owner permissions up to 7 are allowed, but group and other permissions
      # must be zero. This allows mode 0700 or more restrictive.
      if [ -d /boot/efi/EFI ]; then
        for file in $(find /boot/efi/EFI \
          -type f \
          -name 'grub*' \
          -print 2>/dev/null)
        do
          check_grub_file "$file" "0077" "0700"
        done
      fi

      # BIOS/canonical GRUB configuration files:
      # Owner execute and all group/other permissions are prohibited.
      # This allows mode 0600 or more restrictive.
      if [ -d /boot/grub2 ]; then
        for file in $(find /boot/grub2 \
          -maxdepth 1 \
          -type f \
          \( -name 'grub*' -o -name 'user.cfg' \) \
          -print 2>/dev/null)
        do
          check_grub_file "$file" "0177" "0600"
        done
      fi

      if [ "$checked" -eq 0 ]; then
        echo "NON_COMPLIANT: No GRUB configuration files were found"
        exit 1
      fi

      if [ "$failed" -eq 0 ]; then
        echo "** PASS **"
        echo "All discovered GRUB files have compliant ownership and permissions"
      else
        echo "** FAIL **"
