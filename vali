      python3 - <<'CIS_HIGH_CHECK'
      import os, re, subprocess, sys
      try:
          checked = subprocess.run(['/usr/sbin/aide', '--config-check'], text=True, capture_output=True)
          if checked.returncode:
              print('ERROR: AIDE configuration check failed')
              print(checked.stderr.strip())
              sys.exit(2)
          config = '/etc/aide.conf'
          with open(config, encoding='utf-8', errors='replace') as stream:
              lines = [line.split('#', 1)[0].strip() for line in stream]
          required = {'p', 'i', 'n', 'u', 'g', 's', 'b', 'acl', 'xattrs', 'sha512'}
          groups = {}
          for line in lines:
              match = re.fullmatch(r'([A-Za-z][A-Za-z0-9_]*)\s*=\s*([A-Za-z0-9_+\-]+)', line)
              if match:
                  groups[match.group(1)] = match.group(2)
          def expand(expression, seen=None):
              seen = set() if seen is None else seen
              result = set()
              for sign, token in re.findall(r'([+\-]?)([A-Za-z0-9_]+)', expression):
                  if token in groups:
                      if token in seen:
                          raise ValueError('Recursive AIDE attribute group: ' + token)
                      values = expand(groups[token], seen | {token})
                  else:
                      values = {token}
                  result = result - values if sign == '-' else result | values
              return result
          failed = False
          for tool in ('auditctl', 'auditd', 'ausearch', 'aureport', 'autrace', 'augenrules'):
              path = os.path.realpath('/sbin/' + tool)
              if not os.path.isfile(path):
                  print(f'NON_COMPLIANT: missing audit tool {path}')
                  failed = True
                  continue
              # Audit the explicit main-file selection lines prescribed by the workbook.
              matches = [line.split(None, 1)[1] for line in lines
                         if len(line.split(None, 1)) == 2 and line.split(None, 1)[0] == path]
              if not matches:
                  print(f'NON_COMPLIANT: explicit {path} rule missing in {config}')
                  failed = True
                  continue
              for expression in matches:
                  missing = sorted(required - expand(expression))
                  print(f'{config}: {path} attributes={expression} missing={missing or "none"}')
                  failed = failed or bool(missing)
          print('Scope: explicit audit-tool rules in /etc/aide.conf; AIDE syntax/includes checked by aide.')
          sys.exit(1 if failed else 0)
      except (OSError, ValueError) as error:
          print(f'ERROR: cannot complete audit-tool rule audit: {error}')
          sys.exit(2)
      CIS_HIGH_CHECK

