  '3.1.1':
    type: automatic
    requires: [cis_ipv6_policy]
    command: |
      module_disabled="$(cat /sys/module/ipv6/parameters/disable 2>/dev/null)" || exit 2
      echo "IPv6 module disable=$module_disabled policy=$CIS_IPV6_POLICY"
      case "$CIS_IPV6_POLICY" in
        review) exit 1 ;;
        enabled)
          [ "$module_disabled" = 0 ] || exit 1
          all_value="$(sysctl -n net.ipv6.conf.all.disable_ipv6 2>/dev/null)" || exit 2
          default_value="$(sysctl -n net.ipv6.conf.default.disable_ipv6 2>/dev/null)" || exit 2
          echo "runtime all.disable_ipv6=$all_value default.disable_ipv6=$default_value"
          [ "$all_value" = 0 ] && [ "$default_value" = 0 ]
          ;;
        disabled)
          if [ "$module_disabled" != 0 ]; then
            echo 'IPv6 is disabled by the kernel module parameter'
            exit 0
          fi
          all_value="$(sysctl -n net.ipv6.conf.all.disable_ipv6 2>/dev/null)" || exit 2
          default_value="$(sysctl -n net.ipv6.conf.default.disable_ipv6 2>/dev/null)" || exit 2
          persistent_config="$(/usr/lib/systemd/systemd-sysctl --cat-config 2>/dev/null)" || exit 2
          persistent_all="$(awk -F= '
            {key=$1; gsub(/[[:space:]]/, "", key)}
            key == "net.ipv6.conf.all.disable_ipv6" {
              value=$2; sub(/[[:space:]]*[#;].*$/, "", value); gsub(/[[:space:]]/, "", value); result=value
            }
            END {print result}' <<< "$persistent_config")"
          persistent_default="$(awk -F= '
            {key=$1; gsub(/[[:space:]]/, "", key)}
            key == "net.ipv6.conf.default.disable_ipv6" {
              value=$2; sub(/[[:space:]]*[#;].*$/, "", value); gsub(/[[:space:]]/, "", value); result=value
            }
            END {print result}' <<< "$persistent_config")"
          echo "runtime all=$all_value default=$default_value persistent all=${persistent_all:-missing} default=${persistent_default:-missing}"
          [ "$all_value" = 1 ] && [ "$default_value" = 1 ] &&
            [ "$persistent_all" = 1 ] && [ "$persistent_default" = 1 ]
          ;;
        *) exit 2 ;;
      esac
