---  
# Strict exit-code contract: only 0 is compliant. Every executed non-zero
# return code is classified NON_COMPLIANT. Missing site data prevents execution
# and is reported CONFIG_VALUE_MISSING.
cis_kernel_module_check: |
  module="__MODULE__"
  found="$(find /lib/modules -type f -name "${module}.ko*" -print -quit 2>/dev/null)"
  if [ -z "$found" ]; then
    echo "$module is not present in installed kernels"
    exit 0
  fi
  loaded="$(lsmod | awk -v m="${module//-/_}" '$1 == m {print $1}')"
  deny="$(modprobe -n -v "$module" 2>/dev/null)"
  config="$(modprobe --showconfig 2>/dev/null)"
  echo "module=$module loaded=${loaded:-no} deny=${deny:-missing}"
  [ -z "$loaded" ] &&
    grep -Pq "^\h*install\h+${module//-/_}\h+\/bin\/(true|false)\b" <<< "$config" &&
    grep -Pq "^\h*blacklist\h+${module//-/_}\b" <<< "$config"

cis_service_not_in_use_check: |
  units="__UNITS__"
  failed=0
  for unit in $units; do
    enabled="$(systemctl is-enabled "$unit" 2>/dev/null || true)"
    active="$(systemctl is-active "$unit" 2>/dev/null || true)"
    echo "$unit enabled=${enabled:-not-found} active=${active:-not-found}"
    [ "$enabled" = enabled ] && failed=1
    [ "$active" = active ] && failed=1
  done
  exit "$failed"

cis_package_absent_check: |
  package="__PACKAGE__"
  if rpm -q "$package" >/dev/null 2>&1; then
    rpm -q "$package"
    exit 1
  fi
  echo "$package is not installed"
  exit 0

cis_package_present_check: |
  package="__PACKAGE__"
  rpm -q "$package"

# __SPEC__ is TARGET:OPTION.  Mount presence checks use the live mount table;
# mount-option checks intentionally use /etc/fstab because that is the
# supplied Tenable policy value and survives reboot.
cis_mount_policy_check: |
  spec="__SPEC__"
  target="${spec%%:*}"
  option="${spec#*:}"

  if [ "$option" = mounted ]; then
    actual="$(findmnt -n -o TARGET --target "$target" 2>/dev/null)"
    echo "target=$target mounted_as=${actual:-missing}"
    [ "$actual" = "$target" ]
    exit
  fi

  options="$(awk -v target="$target" '
    $1 !~ /^#/ && $2 == target {
      value=$4
    }
    END {
      print value
    }
  ' /etc/fstab 2>/dev/null)"

  # Tenable specifies required: NO for these mount-option controls.
  # If no separate fstab entry exists, the option check is not applicable.
  if [ -z "$options" ]; then
    echo "target=$target has no separate /etc/fstab entry; option check is not applicable"
    exit 0
  fi

  echo "target=$target fstab_options=$options required=$option"
  tr ',' '\n' <<< "$options" | grep -Fxq "$option"

# __SPEC__ contains whitespace-separated key=value pairs.  Both the running
# value and the effective persistent systemd-sysctl configuration must match.
cis_sysctl_policy_check: |
  spec="__SPEC__"
  persistent_config="$(/usr/lib/systemd/systemd-sysctl --cat-config 2>/dev/null)" || exit 2
  failed=0
  for pair in $spec; do
    key="${pair%%=*}"
    expected="${pair#*=}"
    if [[ "$key" == net.ipv6.* ]] && [ "$(cat /sys/module/ipv6/parameters/disable 2>/dev/null || echo 1)" != 0 ]; then
      echo "$key not applicable because IPv6 is disabled"
      continue
    fi
    runtime="$(sysctl -n "$key" 2>/dev/null)" || exit 2
    persistent="$(awk -F= -v key="$key" '
      {
        left=$1; gsub(/[[:space:]]/, "", left)
        if (left == key) {
          right=$2; sub(/[[:space:]]*[#;].*$/, "", right)
          gsub(/[[:space:]]/, "", right); value=right
        }
      }
      END {print value}' <<< "$persistent_config")"
    echo "$key runtime=${runtime:-missing} persistent=${persistent:-missing} expected=$expected"
    [ "$runtime" = "$expected" ] && [ "$persistent" = "$expected" ] || failed=1
  done
  exit "$failed"

# Resolve sshd Match rules for root, the local host/address, and every
# configured listening port, as required by the supplied audit policy.
cis_sshd_effective_check: |
  spec="__SPEC__"
  keyword="${spec%%:*}"
  forbidden="${spec#*:}"
  host="$(hostname)"
  addr="$(getent ahostsv4 "$host" 2>/dev/null | awk 'NR==1 {print $1}')"
  addr="${addr:-127.0.0.1}"
  ports="$(awk 'tolower($1)=="port" {print $2} tolower($1)=="localport" {print $2}' /etc/ssh/sshd_config /etc/ssh/sshd_config.d/*.conf 2>/dev/null | sort -u)"
  ports="${ports:-22}"
  failed=0
  for port in $ports; do
    value="$(sshd -T -C user=root -C host="$host" -C addr="$addr" -C lport="$port" 2>/dev/null | awk -v key="$keyword" 'tolower($1)==key {$1=""; sub(/^ /,""); print}')" || exit 2
    echo "port=$port $keyword=${value:-missing}"
    [ -n "$value" ] || { failed=1; continue; }
    grep -Pqi "$forbidden" <<< "$value" && failed=1
  done
  exit "$failed"

