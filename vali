        exit 1
      fi

      module_disabled="$(
        cat /sys/module/ipv6/parameters/disable 2>/dev/null
      )" || {
        echo "ERROR: Unable to read IPv6 module status"
        exit 2
      }

      boot_entries="$(/usr/sbin/grubby --info=ALL 2>/dev/null)" || {
        echo "ERROR: Unable to read configured boot entries"
        exit 2
      }

      if ! printf '%s\n' "$boot_entries" | grep -q '^args='; then
        echo "ERROR: No boot arguments were returned"
        exit 2
      fi

      failed=0
      echo "IPv6 module disable=$module_disabled; expected=0"

      if [ "$module_disabled" != "0" ]; then
        echo "NON_COMPLIANT: IPv6 remains disabled; reboot may be required"
        failed=1
      fi

      if printf '%s\n' "$boot_entries" |
        grep -Eq '^args=.*(^|[[:space:]"])ipv6\.disable=1([[:space:]"]|$)'; then
        echo "NON_COMPLIANT: A boot entry still disables IPv6"
        failed=1
      fi

      if [ "$failed" -eq 0 ]; then
        echo "COMPLIANT: IPv6 is enabled and listed boot entries do not disable it"
      fi

      exit "$failed"

