      bad="$(grep -RPinE '^[[:space:]]*gpgcheck[[:space:]]*=[[:space:]]*(0|false|no)\b' /etc/yum.repos.d 2>/dev/null || true)"
      echo "global_gpgcheck=${main_value:-unset}"
