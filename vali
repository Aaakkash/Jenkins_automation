  '2.4.1.8':
    type: automatic
    command: |
      # This control is not applicable when cron is not installed.
      if ! rpm -q cronie >/dev/null 2>&1; then
        echo "cronie is not installed; control is not applicable"
        exit 0
      fi

      failed=0

      check_cron_file() {
        file="$1"
        required="$2"

        if [ ! -e "$file" ]; then
          if [ "$required" = true ]; then
            echo "$file is missing"
            failed=1
          else
            echo "$file is absent; acceptable"
          fi
          return
        fi

        mode="$(stat -Lc '%a' "$file")" || {
          echo "Unable to read $file"
          failed=1
          return
        }

        owner_group="$(stat -Lc '%U:%G' "$file")"

        echo "file=$file mode=$mode owner=$owner_group"

        if [ "$owner_group" != "root:root" ]; then
          echo "$file must be owned by root:root"
          failed=1
        fi

        # Reject owner execute, group write/execute and all permissions
        # for other. Modes 0600 and 0640 are compliant.
        if [ "$((8#$mode & 8#137))" -ne 0 ]; then
          echo "$file permissions are too permissive"
          failed=1
        fi
      }

      # cron.allow must exist.
      check_cron_file /etc/cron.allow true

      # cron.deny may be absent or may exist with compliant permissions.
      check_cron_file /etc/cron.deny false

      exit "$failed"

