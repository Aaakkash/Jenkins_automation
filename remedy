---
- name: Track current remediation control
  ansible.builtin.set_fact:
    cis_active_remediation_control_id: "{{ cis_remediation_control_id }}"

- name: "{{ cis_remediation_control_id }} | Run isolated remediation"
  block:
    # Collection selection preparation moved from main.yml.
    - name: Disable all collection rules before selecting failed controls
      ansible.builtin.include_vars:
        file: '{{ role_path }}/vars/disable_all.yml'
    - name: Enable only non-compliant collection controls
      ansible.builtin.set_fact:
        "{{ 'rhel9cis_rule_' ~ (item | replace('.', '_')) ~ '_enabled' }}": true
      loop: '{{ cis_collection_remediation_ids }}'
      loop_control:
        label: '{{ item }}'
    - name: Display enabled collection remediation controls
      ansible.builtin.debug:
        var: cis_collection_remediation_ids

    # Existing supplied custom remediations, with the requested journal fixes.
    # ============================================================
    # 1.4.1 - Configure GRUB bootloader password
    # ============================================================

    - name: 1.4.1 | Configure GRUB bootloader password
      when: "'1.4.1' in cis_custom_remediation_ids"
      become: true
      block:
        - name: 1.4.1 | Confirm GRUB password was supplied
          ansible.builtin.assert:
            that:
              - rhel9cis_bootloader_password | default('') | length > 0
              - "'CHANGE_ME' not in (rhel9cis_bootloader_password | default(''))"
            fail_msg: >-
              Configure rhel9cis_bootloader_password in the encrypted
              config/cis_unix_team_inputs.yml file.
          no_log: true

        - name: 1.4.1 | Check grub2-setpassword command
          ansible.builtin.stat:
            path: /usr/sbin/grub2-setpassword
          register: cis_grub2_setpassword_command

        - name: 1.4.1 | Check canonical GRUB directory
          ansible.builtin.stat:
            path: /boot/grub2
          register: cis_grub2_directory

        - name: 1.4.1 | Confirm GRUB prerequisites
          ansible.builtin.assert:
            that:
              - cis_grub2_setpassword_command.stat.exists
              - cis_grub2_setpassword_command.stat.executable
              - cis_grub2_directory.stat.exists
              - cis_grub2_directory.stat.isdir
            fail_msg: >-
              /usr/sbin/grub2-setpassword or /boot/grub2 is unavailable.
              Confirm that the RHEL 9 GRUB tools are installed.

        - name: 1.4.1 | Generate GRUB PBKDF2 password in canonical directory
          ansible.builtin.expect:
            command: /usr/sbin/grub2-setpassword --output=/boot/grub2
            responses:
              '(?i)Enter password:': "{{ rhel9cis_bootloader_password }}"
              '(?i)Confirm password:': "{{ rhel9cis_bootloader_password }}"
            timeout: 30
          register: cis_grub2_setpassword_result
          changed_when: cis_grub2_setpassword_result.rc == 0
          no_log: true

        - name: 1.4.1 | Read generated GRUB password file status
          ansible.builtin.stat:
            path: /boot/grub2/user.cfg
          register: cis_grub_user_cfg

        - name: 1.4.1 | Verify generated GRUB PBKDF2 entry
          ansible.builtin.command:
            argv:
              - /usr/bin/grep
              - -Eq
              - '^GRUB2_PASSWORD=grub\.pbkdf2\.sha512\.'
              - /boot/grub2/user.cfg
          register: cis_grub_password_hash_check
          changed_when: false
          failed_when: false
          when: cis_grub_user_cfg.stat.exists

        - name: 1.4.1 | Confirm GRUB password remediation completed
          ansible.builtin.assert:
            that:
              - cis_grub_user_cfg.stat.exists
              - cis_grub_password_hash_check.rc | default(1) == 0
            fail_msg: >-
              grub2-setpassword did not create a valid PBKDF2 entry in
              /boot/grub2/user.cfg.

        - name: 1.4.1 | Secure generated GRUB password file
          ansible.builtin.file:
            path: /boot/grub2/user.cfg
            owner: root
            group: root
            mode: "0600"



    # ============================================================
    # 1.4.2 - Secure bootloader configuration files
    # ============================================================

    - name: 1.4.2 | Check UEFI GRUB configuration directory
      when: "'1.4.2' in cis_custom_remediation_ids"
      become: true
      ansible.builtin.stat:
        path: /boot/efi/EFI
      register: cis_uefi_grub_directory

    - name: 1.4.2 | Find UEFI GRUB configuration files
      when:
        - "'1.4.2' in cis_custom_remediation_ids"
        - cis_uefi_grub_directory.stat.exists
      become: true
      ansible.builtin.find:
        paths: /boot/efi/EFI
        patterns: "grub*"
        file_type: file
        recurse: true
      register: cis_uefi_grub_files

    - name: 1.4.2 | Secure UEFI GRUB configuration files
      when:
        - "'1.4.2' in cis_custom_remediation_ids"
        - cis_uefi_grub_directory.stat.exists
      become: true
      ansible.builtin.file:
        path: "{{ item.path }}"
        owner: root
        group: root
        mode: "0700"
        follow: false
      loop: "{{ cis_uefi_grub_files.files | default([]) }}"
      loop_control:
        label: "{{ item.path }}"

    - name: 1.4.2 | Check BIOS GRUB configuration directory
      when: "'1.4.2' in cis_custom_remediation_ids"
      become: true
      ansible.builtin.stat:
        path: /boot/grub2
      register: cis_bios_grub_directory

    - name: 1.4.2 | Find BIOS GRUB configuration files
      when:
        - "'1.4.2' in cis_custom_remediation_ids"
        - cis_bios_grub_directory.stat.exists
      become: true
      ansible.builtin.find:
        paths: /boot/grub2
        patterns:
          - "grub*"
          - "user.cfg"
        file_type: file
        recurse: false
      register: cis_bios_grub_files

    - name: 1.4.2 | Secure BIOS GRUB configuration files
      when:
        - "'1.4.2' in cis_custom_remediation_ids"
        - cis_bios_grub_directory.stat.exists
      become: true
      ansible.builtin.file:
        path: "{{ item.path }}"
        owner: root
        group: root
        mode: "0600"
        follow: false
      loop: "{{ cis_bios_grub_files.files | default([]) }}"
      loop_control:
        label: "{{ item.path }}"
    
    # ============================================================
    # 5.4.2.5 - Root PATH integrity
    # ============================================================

    - name: 5.4.2.5 | Create secure root bin directory
      when:
        - "'5.4.2.5' in cis_custom_remediation_ids"
        - cis_root_bin_action | default('create') == 'create'
      become: true
      ansible.builtin.file:
        path: /root/bin
        state: directory
        owner: root
        group: root
        mode: "0700"

    - name: 5.4.2.5 | Verify root PATH integrity after remediation
      when: "'5.4.2.5' in cis_custom_remediation_ids"
      become: true
      ansible.builtin.shell: |
        root_path="$(sudo -Hiu root env | awk -F= '$1 == "PATH" {print $2; exit}')"
        [ -n "$root_path" ] || { echo 'Unable to determine root PATH'; exit 2; }

        failed=0
        case "$root_path" in
          *::*|:*|*:) echo "Invalid empty root PATH entry: $root_path"; failed=1 ;;
        esac

        old_ifs="$IFS"
        IFS=:
        for directory in $root_path; do
          IFS="$old_ifs"
          [ "$directory" = . ] && { echo 'Root PATH contains dot'; failed=1; IFS=:; continue; }
          [ -d "$directory" ] || { echo "$directory is not a directory"; failed=1; IFS=:; continue; }
          owner="$(stat -Lc '%U' "$directory")"
          mode="$(stat -Lc '%a' "$directory")"
          echo "$directory owner=$owner mode=$mode"
          [ "$owner" = root ] || failed=1
          [ "$((8#$mode & 8#022))" -eq 0 ] || failed=1
          IFS=:
        done
        IFS="$old_ifs"
        exit "$failed"
      args:
        executable: /bin/bash
      changed_when: false

    # ============================================================
    # 5.1.9 - SSH client alive settings
    # ============================================================

    - name: 5.1.9 | Configure effective SSH client alive settings
      when: "'5.1.9' in cis_custom_remediation_ids"
      become: true
      block:
        - name: 5.1.9 | Place SSH settings before Include and Match statements
          ansible.builtin.blockinfile:
            path: /etc/ssh/sshd_config
            marker: "# {mark} ANSIBLE MANAGED CIS 5.1.9"
            insertbefore: BOF
            block: |
              ClientAliveInterval {{ cis_ssh_client_alive_interval }}
              ClientAliveCountMax {{ cis_ssh_client_alive_count_max }}
            owner: root
            group: root
            mode: "0600"
            backup: true
            validate: "/usr/sbin/sshd -t -f %s"
          register: cis_sshd_client_alive_change

        - name: 5.1.9 | Reload sshd
          ansible.builtin.systemd:
            name: sshd
            state: reloaded
          when: cis_sshd_client_alive_change.changed

    # ============================================================
    # 5.3.2.x and related controls - authselect and PAM
    # ============================================================

    - name: Configure authselect and PAM controls
      when:
        - cis_custom_remediation_ids
          | intersect([
              '5.3.2.1',
              '5.3.2.2',
              '5.3.2.4',
              '5.3.3.3.3',
              '5.3.3.4.1'
            ])
          | length > 0
      become: true
      block:
        - name: Read current authselect profile and enabled features
          ansible.builtin.command:
            argv:
              - authselect
              - current
              - --raw
          register: cis_authselect_current
          changed_when: false

        - name: Split current authselect profile and features
          ansible.builtin.set_fact:
            cis_authselect_current_tokens: >-
              {{
                (cis_authselect_current.stdout | trim).split()
              }}

        - name: Confirm an active authselect profile was detected
          ansible.builtin.assert:
            that:
              - cis_authselect_current_tokens | length > 0
            fail_msg: >-
              No active authselect profile was returned by
              'authselect current --raw'.

        - name: Save current authselect profile and enabled features
          ansible.builtin.set_fact:
            cis_authselect_current_profile: >-
              {{
                cis_authselect_current_tokens | first
              }}
            cis_authselect_existing_features: >-
              {{
                cis_authselect_current_tokens[1:]
              }}

        - name: Build required authselect feature list
          ansible.builtin.set_fact:
            cis_authselect_effective_features: >-
              {{
                cis_authselect_existing_features
                | difference(['without-nullok'])
                | union([
                    'with-faillock',
                    'with-pwhistory'
                  ])
                | list
              }}

        - name: Display detected authselect configuration
          ansible.builtin.debug:
            msg:
              base_profile: "{{ cis_authselect_current_profile }}"
              existing_features: "{{ cis_authselect_existing_features }}"
              effective_features: "{{ cis_authselect_effective_features }}"

        - name: Check custom authselect profile PAM template
          ansible.builtin.stat:
            path: >-
              /etc/authselect/custom/{{ cis_authselect_custom_profile }}/system-auth
          register: cis_authselect_custom_profile_status

        - name: Create custom authselect profile from active profile
          ansible.builtin.command:
            argv:
              - authselect
              - create-profile
              - "{{ cis_authselect_custom_profile }}"
              - --base-on
              - "{{ cis_authselect_current_profile }}"
              - --symlink-meta
          register: cis_authselect_profile_creation
          changed_when: cis_authselect_profile_creation.rc == 0
          when:
            - not cis_authselect_custom_profile_status.stat.exists
            - not cis_authselect_current_profile.startswith('custom/')

        - name: 5.3.3.4.1 | Inspect custom PAM profile templates
          ansible.builtin.stat:
            path: >-
              /etc/authselect/custom/{{ cis_authselect_custom_profile }}/{{ item }}
            follow: false
          loop:
            - system-auth
            - password-auth
          register: cis_authselect_pam_templates
          when: "'5.3.3.4.1' in cis_custom_remediation_ids"

        - name: 5.3.3.4.1 | Confirm custom PAM templates are safe to edit
          ansible.builtin.assert:
            that:
              - item.stat.exists | default(false)
              - item.stat.isreg | default(false)
              - not (item.stat.islnk | default(false))
            fail_msg: >-
              The custom authselect template {{ item.item }} is missing or is a
              symbolic link. The role will not modify a vendor authselect profile.
          loop: "{{ cis_authselect_pam_templates.results }}"
          loop_control:
            label: "{{ item.item }}"
          when: "'5.3.3.4.1' in cis_custom_remediation_ids"

        - name: 5.3.3.4.1 | Remove literal nullok from custom PAM templates
          ansible.builtin.replace:
            path: >-
              /etc/authselect/custom/{{ cis_authselect_custom_profile }}/{{ item }}
            regexp: '(?m)^([ \t]*(?:auth|account|password|session)[ \t]+(?:requisite|required|sufficient)[ \t]+pam_unix\.so[^\n\r#]*?)[ \t]+nullok\b'
            replace: '\g<1>'
            backup: true
          loop:
            - system-auth
            - password-auth
          when: "'5.3.3.4.1' in cis_custom_remediation_ids"

        - name: 5.3.3.4.1 | Remove conditional nullok from custom PAM templates
          ansible.builtin.replace:
            path: >-
              /etc/authselect/custom/{{ cis_authselect_custom_profile }}/{{ item }}
            regexp: '[ \t]*\{if not "without-nullok":nullok\}'
            replace: ''
            backup: true
          loop:
            - system-auth
            - password-auth
          when: "'5.3.3.4.1' in cis_custom_remediation_ids"

        - name: Select custom authselect profile with required features
          ansible.builtin.command:
            argv: >-
              {{
                [
                  'authselect',
                  'select',
                  'custom/' ~ cis_authselect_custom_profile
                ]
                +
                cis_authselect_effective_features
                +
                ['--force']
              }}
          register: cis_authselect_select_result
          changed_when: >-
            'Profile was selected' in cis_authselect_select_result.stdout
            or
            'Make sure that SSSD service is configured' in
            cis_authselect_select_result.stdout

        - name: Apply authselect changes
          ansible.builtin.command:
            argv:
              - authselect
              - apply-changes
          register: cis_authselect_apply_result
          changed_when: >-
            'Changes were successfully applied' in
            cis_authselect_apply_result.stdout

        - name: Verify authselect configuration
          ansible.builtin.command:
            argv:
              - authselect
              - check
          register: cis_authselect_check
          changed_when: false

        - name: 5.3.3.4.1 | Confirm nullok is absent from generated PAM files
          ansible.builtin.shell: |
            if grep -Pq \
              '^[^#\n]*pam_unix\.so[^\n]*\bnullok\b' \
              /etc/pam.d/system-auth \
              /etc/pam.d/password-auth; then
              echo 'nullok remains in the generated PAM configuration'
              exit 1
            fi
            echo 'nullok is absent from the generated PAM configuration'
          args:
            executable: /bin/bash
          changed_when: false
          when: "'5.3.3.4.1' in cis_custom_remediation_ids"

 

    # ============================================================
    # 6.1.2 - AIDE scheduled integrity check
    # ============================================================

    - name: 6.1.2 | Configure scheduled AIDE integrity check
      when: "'6.1.2' in cis_custom_remediation_ids"
      become: true
      block:
        - name: 6.1.2 | Ensure AIDE is installed
          ansible.builtin.dnf:
            name: aide
            state: present

        - name: 6.1.2 | Schedule daily AIDE check
          ansible.builtin.cron:
            name: Run AIDE filesystem integrity check
            cron_file: cis-aide
            user: root
            minute: "{{ cis_aide_cron_minute }}"
            hour: "{{ cis_aide_cron_hour }}"
            day: "*"
            month: "*"
            weekday: "*"
            job: "/usr/sbin/aide --check"


    # ============================================================
    # 7.1.11 - World-writable files and directories
    # ============================================================

    - name: 7.1.11 | Secure world-writable files and directories
      when: "'7.1.11' in cis_custom_remediation_ids"
      become: true
      block:
        - name: 7.1.11 | Read local filesystem mount points
          ansible.builtin.command:
            argv:
              - findmnt
              - -rn
              - -t
              - ext2,ext3,ext4,xfs,btrfs
              - -o
              - TARGET
          register: cis_local_filesystem_mounts
          changed_when: false

        - name: 7.1.11 | Find world-writable files
          ansible.builtin.command:
            argv:
              - find
              - "{{ item }}"
              - -xdev
              - -type
              - f
              - -perm
              - "-0002"
              - -print
          loop: "{{ cis_local_filesystem_mounts.stdout_lines }}"
          register: cis_world_writable_file_search
          changed_when: false
          failed_when: false

        - name: 7.1.11 | Remove other-write permission from files
          ansible.builtin.file:
            path: "{{ item }}"
            mode: "o-w"
          loop: >-
            {{
              cis_world_writable_file_search.results
              | map(attribute='stdout_lines')
              | flatten
              | unique
              | list
            }}
          loop_control:
            label: "{{ item }}"

        - name: 7.1.11 | Find world-writable directories without sticky bit
          ansible.builtin.command:
            argv:
              - find
              - "{{ item }}"
              - -xdev
              - -type
              - d
              - -perm
              - "-0002"
              - "!"
              - -perm
              - "-1000"
              - -print
          loop: "{{ cis_local_filesystem_mounts.stdout_lines }}"
          register: cis_world_writable_directory_search
          changed_when: false
          failed_when: false

        - name: 7.1.11 | Add sticky bit to world-writable directories
          ansible.builtin.file:
            path: "{{ item }}"
            mode: "a+t"
          loop: >-
            {{
              cis_world_writable_directory_search.results
              | map(attribute='stdout_lines')
              | flatten
              | unique
              | list
            }}
          loop_control:
            label: "{{ item }}"


    # ============================================================
    # 7.1.12 - Unowned or ungrouped filesystem objects
    # ============================================================

    - name: 7.1.12 | Apply configured ownership to unowned paths
      when:
        - "'7.1.12' in cis_custom_remediation_ids"
        - cis_unowned_path_ownership | default([]) | length > 0
      become: true
      block:
        - name: 7.1.12 | Check configured unowned paths
          ansible.builtin.stat:
            path: "{{ item.path }}"
            follow: false
          loop: "{{ cis_unowned_path_ownership }}"
          loop_control:
            label: "{{ item.path }}"
          register: cis_unowned_path_status

        - name: 7.1.12 | Correct configured path ownership
          ansible.builtin.file:
            path: "{{ item.item.path }}"
            owner: "{{ item.item.owner }}"
            group: "{{ item.item.group }}"
            recurse: "{{ item.item.recurse | default(false) }}"
            follow: false
          loop: "{{ cis_unowned_path_status.results }}"
          loop_control:
            label: "{{ item.item.path }}"
          when: item.stat.exists | default(false)


    # ============================================================
    # 7.2.3 - Ensure root is the only GID 0 group
    # Audit/report only, as requested. No group is changed automatically.
    # ============================================================

    - name: 7.2.3 | Find all groups with GID 0
      when: "'7.2.3' in cis_custom_remediation_ids"
      become: true
      ansible.builtin.shell: |
        awk -F: '($3 == 0) {print $1}' /etc/group
      register: gid0_groups
      changed_when: false

    - name: 7.2.3 | Report groups with GID 0
      when: "'7.2.3' in cis_custom_remediation_ids"
      ansible.builtin.debug:
        msg: "Groups with GID 0: {{ gid0_groups.stdout_lines }}"
 
    #########################################################################
    # 1.2.1.1 - Approved GPG keys
    #########################################################################

    - name: 1.2.1.1 | Import approved package-signing keys
      become: true
      ansible.builtin.rpm_key:
        key: "{{ item }}"
        state: present
      loop: "{{ cis_approved_gpg_key_files | default([]) }}"
      loop_control:
        label: "{{ item }}"
      when:
        - "'1.2.1.1' in cis_custom_remediation_ids"
        - cis_gpg_key_policy_configured | default(false) | bool
        - cis_approved_gpg_key_files | default([]) | length > 0


    #########################################################################
    # 1.2.1.4 - Approved repositories
    #########################################################################

    - name: 1.2.1.4 | Configure explicitly supplied repositories
      become: true
      ansible.builtin.yum_repository:
        name: "{{ item.id }}"
        description: "{{ item.description | default(item.id) }}"
        baseurl: "{{ item.baseurl | default(omit) }}"
        mirrorlist: "{{ item.mirrorlist | default(omit) }}"
        metalink: "{{ item.metalink | default(omit) }}"
        enabled: "{{ item.enabled | default(true) }}"
        gpgcheck: "{{ item.gpgcheck | default(true) }}"
        gpgkey: "{{ item.gpgkey | default(omit) }}"
        state: present
      loop: "{{ cis_repository_definitions | default([]) }}"
      loop_control:
        label: "{{ item.id }}"
      when:
        - "'1.2.1.4' in cis_custom_remediation_ids"
        - cis_repository_policy_configured | default(false) | bool
        - cis_repository_definitions | default([]) | length > 0


    #########################################################################
    # 2.1.22 - Unapproved listening services
    #########################################################################

    - name: 2.1.22 | Validate listener remediation configuration
      ansible.builtin.assert:
        that:
          - item.unit | default('') | length > 0
          - item.action | default('') in ['stop', 'mask', 'remove']
          - item.action != 'remove' or item.package | default('') | length > 0
        fail_msg: >-
          Listener remediation requires unit and action=stop|mask|remove.
          The remove action also requires package.
      loop: "{{ cis_listener_remediation_actions | default([]) }}"
      loop_control:
        label: "{{ item.unit | default('invalid entry') }}"
      when: "'2.1.22' in cis_custom_remediation_ids"

    - name: 2.1.22 | Stop explicitly unapproved listener units
      become: true
      ansible.builtin.systemd_service:
        name: "{{ item.unit }}"
        state: stopped
        enabled: false
      loop: "{{ cis_listener_remediation_actions | default([]) }}"
      loop_control:
        label: "{{ item.unit }}"
      when:
        - "'2.1.22' in cis_custom_remediation_ids"
        - item.action in ['stop', 'mask', 'remove']

    - name: 2.1.22 | Mask explicitly unapproved listener units
      become: true
      ansible.builtin.systemd_service:
        name: "{{ item.unit }}"
        masked: true
      loop: "{{ cis_listener_remediation_actions | default([]) }}"
      loop_control:
        label: "{{ item.unit }}"
      when:
        - "'2.1.22' in cis_custom_remediation_ids"
        - item.action == 'mask'

    - name: 2.1.22 | Remove explicitly unapproved service packages
      become: true
      ansible.builtin.dnf:
        name: "{{ item.package }}"
        state: absent
      loop: "{{ cis_listener_remediation_actions | default([]) }}"
      loop_control:
        label: "{{ item.package | default(item.unit) }}"
      when:
        - "'2.1.22' in cis_custom_remediation_ids"
        - item.action == 'remove'
        - item.package | default('') | length > 0


    #########################################################################
    # 6.2.1.2 - Journald log-file permissions
    #########################################################################

    - name: 6.2.1.2 | Configure tmpfiles journal file permissions
      become: true
      when: "'6.2.1.2' in cis_custom_remediation_ids"
      block:
        - name: Confirm journal permission input
          ansible.builtin.assert:
            that:
              - cis_journal_file_policy_configured | bool
              - "cis_journal_file_mode is match('^0[0-7]{3}$')"
              - "cis_journal_file_mode == '0640'"
        - name: Copy vendor tmpfiles configuration if no override exists
          ansible.builtin.copy:
            src: /usr/lib/tmpfiles.d/systemd.conf
            dest: /etc/tmpfiles.d/systemd.conf
            remote_src: true
            force: false
            owner: root
            group: root
            mode: '0644'
        - name: Update explicit journal-file permission rules
          ansible.builtin.replace:
            path: /etc/tmpfiles.d/systemd.conf
            regexp: ^([ \t]*z[ \t]+/(?:var|run)/log/journal/\S*\.journal\S*[ \t]+)\S+
            replace: \g<1>{{ cis_journal_file_mode }}
            backup: true
        - name: Add journal-file rules without changing directory permissions
          ansible.builtin.blockinfile:
            path: /etc/tmpfiles.d/systemd.conf
            marker: '# {mark} CIS JOURNAL FILE PERMISSIONS'
            backup: true
            block: |
              z /var/log/journal/*/*.journal* {{ cis_journal_file_mode }} - - - -
              z /run/log/journal/*/*.journal* {{ cis_journal_file_mode }} - - - -
        - name: Discover persistent and runtime journal files
          ansible.builtin.find:
            paths:
              - /var/log/journal
              - /run/log/journal
            recurse: true
            file_type: file
            patterns:
              - '*.journal'
              - '*.journal~'
          register: cis_three_journal_files
        - name: Set existing journal-file modes from config
          ansible.builtin.file:
            path: '{{ item.path }}'
            mode: '{{ cis_journal_file_mode }}'
          loop: '{{ cis_three_journal_files.files }}'
          loop_control:
            label: '{{ item.path }}'

    - name: 6.2.1.3 | Append configured limits under the existing Journal section
      become: true
      when: "'6.2.1.3' in cis_custom_remediation_ids"
      block:
        - name: Confirm rotation policy is configured
          ansible.builtin.assert:
            that:
              - cis_journald_rotation_policy_configured | bool
        - name: Read main journald configuration
          ansible.builtin.slurp:
            src: /etc/systemd/journald.conf
          register: cis_three_journald_before
        - name: Confirm the existing final section is Journal
          ansible.builtin.assert:
            that:
              - |-
                ((cis_three_journald_before.content | b64decode)
                 | regex_findall('(?m)^\s*\[([^\]\r\n]+)\][ \t]*$')
                 | last | default('')) == 'Journal'
            fail_msg: The last section in /etc/systemd/journald.conf is not [Journal]. Appending settings at EOF would put them in the wrong section.
        - name: Append policy values at EOF without another section header
          ansible.builtin.blockinfile:
            path: /etc/systemd/journald.conf
            marker: '# {mark} CIS JOURNAL ROTATION'
            insertafter: EOF
            backup: true
            block: |
              SystemMaxUse={{ cis_journald_system_max_use }}
              SystemKeepFree={{ cis_journald_system_keep_free }}
              RuntimeMaxUse={{ cis_journald_runtime_max_use }}
              RuntimeKeepFree={{ cis_journald_runtime_keep_free }}
              MaxFileSec={{ cis_journald_max_file_sec }}
          register: cis_three_rotation_change
        - name: Restart journald only after a configuration change
          ansible.builtin.systemd_service:
            name: systemd-journald.service
            state: restarted
          when: cis_three_rotation_change.changed

    - name: 6.2.2.1.2 | Check journal-upload unit availability
