    - name: 1.3.1.2 | Check for SELinux-disabling kernel arguments
      ansible.builtin.shell: |
        set -o pipefail
        grubby --info=ALL |
          grep -Po '(selinux|enforcing)=0' || true
      args:
        executable: /bin/bash
      register: cis_selinux_disabled_kernel_arguments
      changed_when: false
      when: "'1.3.1.2' in cis_custom_remediation_ids"
    - name: 1.3.1.2 | Remove SELinux-disabling arguments from all kernels
      ansible.builtin.command:
        argv:
          - grubby
          - --update-kernel=ALL
          - --remove-args=selinux=0 enforcing=0
      when:
        - "'1.3.1.2' in cis_custom_remediation_ids"
        - cis_selinux_disabled_kernel_arguments.stdout | trim | length > 0
      changed_when: true
    - name: 1.3.1.2 | Remove SELinux-disabling arguments from GRUB defaults
      ansible.builtin.replace:
        path: /etc/default/grub
        regexp: (^|\s+)(selinux|enforcing)=0(?=\s|$)
        replace: \1
      when: "'1.3.1.2' in cis_custom_remediation_ids"
    #########################################################################
    # 3.1.1 - Enable IPv6 to match lxsb02elkes
    #########################################################################

    - name: 3.1.1 | Enable IPv6 in configured boot entries
      become: true
      when: "'3.1.1' in cis_custom_remediation_ids"
      block:
        - name: 3.1.1 | Confirm selected IPv6 policy
          ansible.builtin.assert:
            that:
              - cis_ipv6_policy == 'enabled'
            fail_msg: This remediation requires cis_ipv6_policy=enabled.

        - name: 3.1.1 | Read configured boot entries
          ansible.builtin.command:
            argv:
              - /usr/sbin/grubby
              - --info=ALL
          register: cis_ipv6_boot_entries
          changed_when: false

        - name: 3.1.1 | Remove IPv6 disable argument from all boot entries
          ansible.builtin.command:
            argv:
              - /usr/sbin/grubby
              - --update-kernel=ALL
              - --remove-args=ipv6.disable=1
          when: >-
            cis_ipv6_boot_entries.stdout is
            search('(?m)^args=.*\bipv6\.disable=1\b')

        - name: 3.1.1 | Read current IPv6 module status
          ansible.builtin.slurp:
            src: /sys/module/ipv6/parameters/disable
          register: cis_ipv6_runtime_status

        - name: 3.1.1 | Report reboot requirement
          ansible.builtin.debug:
            msg: >-
              {{
                'IPv6 is enabled. No reboot is required for this control.'
                if (cis_ipv6_runtime_status.content | b64decode | trim) == '0'
                else
                'Boot configuration updated. Reboot the server, then rerun validation to confirm IPv6 is enabled.'
              }}
          
    - name: Install libpwquality for control 5.3.1.3
      ansible.builtin.dnf:
        name: libpwquality
        state: latest
      when: "'5.3.1.3' in cis_custom_remediation_ids"
    - name: Remediate nftables controls using approved inputs
      when:
        - "cis_firewall_backend == 'nftables'"
        - "cis_custom_remediation_ids | intersect(['4.1.1', '4.3.1', '4.3.2', '4.3.3']) | length > 0"
      block:
        - name: Install nftables package
          ansible.builtin.dnf:
            name: nftables
            state: present

        - name: Collect service facts before selecting firewall backend
          ansible.builtin.service_facts:

        - name: Stop, disable and mask firewalld when nftables is selected
          ansible.builtin.systemd_service:
            name: firewalld.service
            state: stopped
            enabled: false
            masked: true
          when:
            - cis_firewall_backend == 'nftables'
            - "'firewalld.service' in ansible_facts.services"

        - name: Ensure nftables is unmasked before activation
          ansible.builtin.systemd_service:
            name: nftables.service
            masked: false
          when: cis_firewall_backend == 'nftables'

        - name: Create nftables configuration directory
          ansible.builtin.file:
            path: /etc/nftables
            state: directory
            owner: root
            group: root
            mode: '0750'

        - name: Install validated CIS nftables rules
          ansible.builtin.template:
            src: cis-nftables.nft.j2
            dest: /etc/nftables/cis-rhel9.nft
            owner: root
            group: root
            mode: '0600'
            backup: true
            validate: /usr/sbin/nft -c -f %s
          register: cis_nftables_rules

        - name: Configure nftables service loader
          ansible.builtin.copy:
            dest: /etc/sysconfig/nftables.conf
            owner: root
            group: root
            mode: '0600'
            backup: true
            content: |
              include "/etc/nftables/cis-rhel9.nft"
          register: cis_nftables_loader

        - name: Enable and start nftables with approved rules
          ansible.builtin.systemd_service:
            name: nftables.service
            enabled: true
            state: restarted
          when: cis_nftables_rules.changed or cis_nftables_loader.changed

        - name: Ensure nftables remains enabled and active
          ansible.builtin.systemd_service:
            name: nftables.service
            enabled: true
            state: started
          when: cis_firewall_backend == 'nftables'
    - name: 1.1.2.1.4 | Preserve and secure existing /tmp mount
      when: '''1.1.2.1.4'' in cis_custom_remediation_ids'
      become: true
      block:
      - name: 1.1.2.1.4 | Read the existing fstab mount
        ansible.builtin.shell: "python3 - <<'PYM'\nimport json\nrows=[]\nfor line in open('/etc/fstab'):\n    f=line.split()\n\
          \    if f and not f[0].startswith('#') and len(f)>=4 and f[1]=='/tmp':\n        rows.append(dict(src=f[0],fstype=f[2],opts=f[3],dump=f[4]\
          \ if len(f)>4 else '0',passno=f[5] if len(f)>5 else '0'))\nif len(rows)!=1: raise SystemExit('Expected exactly\
          \ one /tmp entry in /etc/fstab; no mount layout changes were attempted')\nprint(json.dumps(rows[0]))\nPYM"
        args:
          executable: /bin/bash
        register: cis_tmp_entry
        changed_when: false
      - name: 1.1.2.1.4 | Add noexec and ensure mount is active
        ansible.posix.mount:
          path: /tmp
          src: '{{ (cis_tmp_entry.stdout | from_json).src }}'
          fstype: '{{ (cis_tmp_entry.stdout | from_json).fstype }}'
          opts: '{{ ((cis_tmp_entry.stdout | from_json).opts.split('','') | difference([''exec'']) | union([''noexec'']))
            | join('','') }}'
          dump: '{{ (cis_tmp_entry.stdout | from_json).dump }}'
          passno: '{{ (cis_tmp_entry.stdout | from_json).passno }}'
          state: mounted
          backup: true
      - name: 1.1.2.1.4 | Ensure live mount has noexec
        ansible.posix.mount:
          path: /tmp
          state: remounted
    - name: 2.4.1.7 | Secure cron.d directory
