        loop: '{{ cis_extra_audit_tools.results }}'
        loop_control:
          label: '{{ item.item }}'
      - name: 6.1.3 | Configure SHA512 integrity rules
        ansible.builtin.blockinfile:
          path: /etc/aide.conf
          marker: '# {mark} CIS audit tool integrity'
          block: '/usr/sbin/auditctl p+i+n+u+g+s+b+acl+xattrs+sha512

            /usr/sbin/auditd p+i+n+u+g+s+b+acl+xattrs+sha512

            /usr/sbin/ausearch p+i+n+u+g+s+b+acl+xattrs+sha512

