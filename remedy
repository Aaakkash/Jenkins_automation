          file_type: file
        register: cis_extra_pwquality_fragments
      - name: 5.3.3.2.4 | Remove duplicate fragment assignments
        ansible.builtin.lineinfile:
          path: '{{ item.path }}'
          regexp: ^\s*maxrepeat\s*=.*$
          state: absent
          backup: true
        loop: '{{ cis_extra_pwquality_fragments.files }}'
        loop_control:
          label: '{{ item.path }}'
      - name: 5.3.3.2.4 | Set approved policy value
        ansible.builtin.lineinfile:
          path: /etc/security/pwquality.conf
          regexp: ^\s*maxrepeat\s*=.*$
          line: maxrepeat={{ cis_password_maxrepeat }}
          create: true
          owner: root
          group: root
          mode: '0644'
          backup: true
    - name: 5.3.3.2.5 | Configure maxsequence
      when: '''5.3.3.2.5'' in cis_custom_remediation_ids'
      become: true
      block:
      - name: 5.3.3.2.5 | Require valid policy value
        ansible.builtin.assert:
          that:
          - cis_password_maxsequence | int >= 1
          - cis_password_maxsequence | int <= 3
      - name: 5.3.3.2.5 | Ensure libpwquality is installed
        ansible.builtin.dnf:
          name: libpwquality
          state: present
      - name: 5.3.3.2.5 | Find password policy fragments
        ansible.builtin.find:
          paths: /etc/security/pwquality.conf.d
          patterns: '*.conf'
          file_type: file
        register: cis_extra_pwquality_fragments
      - name: 5.3.3.2.5 | Remove duplicate fragment assignments
        ansible.builtin.lineinfile:
          path: '{{ item.path }}'
          regexp: ^\s*maxsequence\s*=.*$
          state: absent
          backup: true
        loop: '{{ cis_extra_pwquality_fragments.files }}'
        loop_control:
          label: '{{ item.path }}'
      - name: 5.3.3.2.5 | Set approved policy value
        ansible.builtin.lineinfile:
          path: /etc/security/pwquality.conf
          regexp: ^\s*maxsequence\s*=.*$
          line: maxsequence={{ cis_password_maxsequence }}
          create: true
          owner: root
          group: root
          mode: '0644'
          backup: true

    - name: Apply collection remediation for proven failures only
      ansible.builtin.include_role:
        name: trippsc2.cis.rhel9
        allow_duplicates: true
      vars:
        rhel9cis_ipv6_needed: "{{ cis_ipv6_policy == 'disabled' }}"
        rhel9cis_use_motd: true
        rhel9cis_use_issue: true
        rhel9cis_use_issue_net: true
        rhel9cis_motd_banner: '{{ cis_motd_banner_text }}'
        rhel9cis_issue_banner: '{{ cis_local_login_banner_text }}'
        rhel9cis_issue_net_banner: '{{ cis_remote_login_banner_text }}'
        rhel9cis_chrony_servers: '{{ cis_chrony_sources }}'
        rhel9cis_firewall: firewalld
        rhel9cis_sshd_allow_users: '{{ cis_ssh_allowed_users }}'
        rhel9cis_sshd_allow_groups: '{{ cis_ssh_allowed_groups }}'
        rhel9cis_sshd_deny_users: '{{ cis_ssh_denied_users }}'
        rhel9cis_sshd_deny_groups: '{{ cis_ssh_denied_groups }}'
        rhel9cis_sshd_client_alive_interval: '{{ cis_ssh_client_alive_interval }}'
        rhel9cis_sshd_client_alive_count_max: '{{ cis_ssh_client_alive_count_max }}'
        rhel9cis_sudo_log_file: '{{ cis_sudo_log_file }}'
        rhel9cis_lockout_failed_attempts: '{{ cis_password_failed_attempts }}'
        rhel9cis_lockout_unlock_time: '{{ cis_password_unlock_time }}'
        rhel9cis_password_min_length: '{{ cis_password_min_length }}'
        rhel9cis_passwords_remembered: '{{ cis_password_history }}'
        rhel9cis_password_expiration_warning_days: '{{ cis_password_warning_days }}'
        rhel9cis_syslog: '{{ cis_logging_backend }}'
        rhel9cis_remote_log_server: '{{ cis_remote_log_host }}'
        rhel9cis_journald_systemmaxuse: "{{ cis_journald_system_max_use | default('10M', true) }}"
        rhel9cis_journald_systemkeepfree: "{{ cis_journald_system_keep_free | default('100G', true) }}"
        rhel9cis_journald_runtimemaxuse: "{{ cis_journald_runtime_max_use | default('10M', true) }}"
        rhel9cis_journald_runtimekeepfree: "{{ cis_journald_runtime_keep_free | default('100G', true) }}"
        rhel9cis_journald_maxfilesec: "{{ cis_journald_max_file_sec | default('1month', true) }}"
        rhel9cis_journal_server_key_file: |-
          {{
            cis_journal_upload_server_key_file
            | default('/etc/ssl/private/journal-upload.pem', true)
          }}
        rhel9cis_journal_server_cert_file: |-
          {{
            cis_journal_upload_server_certificate_file
            | default('/etc/ssl/certs/journal-upload.pem', true)
          }}
        rhel9cis_journal_server_trusted_cert_file: |-
          {{
            cis_journal_upload_trusted_certificate_file
            | default('/etc/ssl/ca/trusted.pem', true)
          }}
        rhel9cis_logrotate_frequency: '{{ cis_rsyslog_rotation_frequency }}'
        _rhel9cis_expected_crypto_policy: |-
          {{ rhel9cis_crypto_policy }}{{ ':NO-SHA1'
               if '1.6.3' in cis_remediation_ids else ''
          }}{{ ':NO-WEAKMAC'
               if '1.6.4' in cis_remediation_ids else ''
          }}{{ ':NO-SSHCBC'
               if '1.6.5' in cis_remediation_ids else ''
          }}{{ ':NO-SSHCHACHA20'
               if '1.6.6' in cis_remediation_ids else ''
          }}{{ ':NO-SSHETM'
               if '1.6.7' in cis_remediation_ids else ''
          }}{% for cis_crypto_subpolicy in
                    rhel9cis_additional_crypto_subpolicies | default([])
          %}:{{ cis_crypto_subpolicy }}{% endfor %}
      when: cis_collection_remediation_ids | length > 0
    - name: Apply pending CIS collection handlers before post-validation
      ansible.builtin.meta: flush_handlers

  rescue:
    - name: Record failed control and continue with the next control
      ansible.builtin.set_fact:
        cis_remediation_errors: >-
          {{ cis_remediation_errors | default([]) + [{
            'control_id': cis_remediation_control_id,
            'task': ansible_failed_task.name | default('Unknown task'),
            'message': (
              'REDACTED: Ansible no_log task'
              if (ansible_failed_result._ansible_no_log | default(false) | bool)
                 or (ansible_failed_task.no_log | default(false) | bool)
              else ansible_failed_result.msg | default('Task failed')
            ),
            'rc': ansible_failed_result.rc | default('not returned')
          }] }}
