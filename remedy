          backup: true
          validate: /usr/sbin/aide --config %s --config-check
    - name: 7.2.9 | Restrict interactive user dot files
      ansible.builtin.shell: "python3 - <<'PYDOT'\nimport os,pwd,json,stat\nselected=json.loads(os.environ['CIS_DOT_USERS'])\n\
        uid_min=1000\nwith open('/etc/login.defs') as f:\n    for line in f:\n        fields=line.split()\n        if\
        \ len(fields)>1 and fields[0]=='UID_MIN': uid_min=int(fields[1])\nusers=[pwd.getpwnam(x) for x in selected]\
        \ if selected else [p for p in pwd.getpwall() if p.pw_uid>=uid_min and not p.pw_shell.endswith(('nologin','false'))]\n\
        for user in users:\n    home=user.pw_dir\n    if not os.path.isdir(home): continue\n    if home=='/' or os.path.islink(home):\
        \ raise RuntimeError('Unsafe home directory for '+user.pw_name)\n    for name in ('.forward','.rhosts'):\n \
        \       source=os.path.join(home,name)\n        if os.path.lexists(source):\n            dest=source+'.cis-disabled'\n\
        \            if os.path.lexists(dest): raise RuntimeError('Existing quarantine path: '+dest)\n            os.rename(source,dest)\n\
        \            print('renamed '+source+' -> '+dest)\n    with os.scandir(home) as entries:\n        for entry\
        \ in entries:\n            if not entry.name.startswith('.') or not entry.is_file(follow_symlinks=False): continue\n\
        \            before=entry.stat(follow_symlinks=False)\n            if before.st_uid!=user.pw_uid:\n        \
        \        os.chown(entry.path,user.pw_uid,-1,follow_symlinks=False)\n                print('owner '+entry.path+'\
        \ -> '+user.pw_name)\n            allowed=0o600 if entry.name in ('.netrc','.bash_history') else 0o644\n   \
        \         mode=stat.S_IMODE(before.st_mode)&allowed\n            if mode!=stat.S_IMODE(before.st_mode):\n  \
        \              os.chmod(entry.path,mode,follow_symlinks=False)\n                print('mode '+entry.path+' ->\
        \ '+format(mode,'04o'))\nPYDOT"
      become: true
      args:
        executable: /bin/bash
      environment:
        CIS_DOT_USERS: '{{ cis_local_interactive_users | default([]) | to_json }}'
      register: cis_extra_dot_changes
      changed_when: cis_extra_dot_changes.stdout | trim | length > 0
      when: '''7.2.9'' in cis_custom_remediation_ids'
    - name: 5.3.3.2.1 | Configure difok
