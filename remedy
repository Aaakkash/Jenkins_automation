    - name: 6.2.2.1.2 | Restart journal-upload after configuration change
      become: true
      ansible.builtin.systemd_service:
        name: systemd-journal-upload.service
        state: restarted
      when:
        - "'6.2.2.1.2' in cis_custom_remediation_ids"
        - cis_journal_upload_configuration is defined
        - cis_journal_upload_configuration.changed | default(false)


    # ============================================================
    # 6.2.3.8 - Rsyslog log rotation
    # ============================================================

    - name: 6.2.3.8 | Configure automatic rsyslog rotation
      become: true
      when: "'6.2.3.8' in cis_custom_remediation_ids"
      block:
        - name: Ensure logrotate is installed
          ansible.builtin.dnf:
            name: logrotate
            state: present

        - name: Configure rotation for existing standard rsyslog destinations
          ansible.builtin.copy:
            dest: /etc/logrotate.d/rsyslog
            owner: root
            group: root
            mode: "0644"
            backup: true
            content: |
              /var/log/cron
              /var/log/maillog
              /var/log/messages
              /var/log/secure
              /var/log/spooler
              {
                  {{ cis_rsyslog_rotation_frequency }}
                  rotate {{ cis_rsyslog_rotation_count }}
                  missingok
                  notifempty
                  compress
                  delaycompress
                  create 0640 root root
                  sharedscripts
                  postrotate
                      /usr/bin/systemctl -s HUP kill rsyslog.service >/dev/null 2>&1 || true
                  endscript
              }

        - name: Validate complete logrotate configuration without rotating
          ansible.builtin.command:
            argv:
              - /usr/sbin/logrotate
              - --debug
              - /etc/logrotate.conf
          changed_when: false

        - name: Enable automatic rotation
          ansible.builtin.systemd_service:
            name: logrotate.timer
            enabled: true
            state: started


 
