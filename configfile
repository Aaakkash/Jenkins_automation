# Cleaned single site-input configuration for the three requested controls.
# Duplicate definitions removed; the previous effective (last) values were retained.
# Existing bootloader values are preserved. Encrypt this file as in your current setup.
# cis_journald_rotation is authoritative; scalar aliases below agree with it.
# cis_requested_control_ids limits this run; use [] later for normal phase selection.
# Incomplete policy values for other controls are retained for review, not guessed.
rhel9cis_bootloader_password: 
cis_root_bin_action: create
grub_pbkdf2_hash: 
cis_backup_root: /var/backups/rhel9-cis
cis_reboot_allowed: false
cis_remediation_skip_ids: 
  - 4.3.2
  - 4.3.1
  - 4.3.3
  
